{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authorized user account with role-based permissions",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["developer", "normal"],
          "description": "Role determining developer or examiner capabilities"
        },
        "title": {
          "type": "string",
          "description": "Academic title or professional role designation"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["email", "name", "role", "title"]
    },
    "Student": {
      "title": "Student",
      "description": "Master student candidate record aligned with FBISE registry standards",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student identifier"
        },
        "rollNumber": {
          "type": "string",
          "description": "Official FBISE Examination Roll Number"
        },
        "fullName": {
          "type": "string",
          "description": "Candidate full name"
        },
        "fatherName": {
          "type": "string",
          "description": "Father or guardian name"
        },
        "registrationNumber": {
          "type": "string",
          "description": "FBISE Academic Registration ID"
        },
        "group": {
          "type": "string",
          "description": "Academic study group"
        },
        "institution": {
          "type": "string",
          "description": "Registered School or College"
        },
        "shift": {
          "type": "string",
          "enum": ["morning", "evening"],
          "description": "Exam shift"
        },
        "enrollmentStatus": {
          "type": "string",
          "description": "Candidate enrollment status"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of record update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or user ID of last updater"
        }
      },
      "required": ["id", "rollNumber", "fullName", "fatherName", "registrationNumber", "group", "institution"]
    },
    "Paper": {
      "title": "Paper",
      "description": "Evaluated handwritten student examination paper with marks and storage URLs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique paper record identifier"
        },
        "studentId": {
          "type": "string",
          "description": "Reference to candidate student record"
        },
        "subject": {
          "type": "string",
          "description": "Subject title"
        },
        "status": {
          "type": "string",
          "description": "Grading review status"
        },
        "totalMarks": {
          "type": "number",
          "description": "Sum of marks awarded"
        },
        "maxMarks": {
          "type": "number",
          "description": "Maximum marks possible for paper"
        },
        "pageImages": {
          "type": "array",
          "description": "Cloud Storage URLs or storage paths for script page images"
        },
        "shift": {
          "type": "string",
          "description": "Examination shift"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last modification"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or user ID of modifier"
        }
      },
      "required": ["id", "studentId", "subject", "status", "totalMarks", "maxMarks"]
    },
    "MarkingScheme": {
      "title": "MarkingScheme",
      "description": "Standardized FBISE grading blueprint and rubrics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique marking scheme identifier"
        },
        "subject": {
          "type": "string",
          "description": "Examination subject"
        },
        "shift": {
          "type": "string",
          "description": "Examination shift"
        },
        "examSession": {
          "type": "string",
          "description": "Academic examination session"
        },
        "title": {
          "type": "string",
          "description": "Rubric title"
        },
        "totalMarks": {
          "type": "number",
          "description": "Total marks for scheme"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "updatedBy": {
          "type": "string",
          "description": "User who modified scheme"
        }
      },
      "required": ["id", "subject", "title", "totalMarks"]
    }
  },
  "firestore": {
    "/users/{userEmail}": {
      "schema": "User",
      "description": "Authorized user profiles keyed by lowercase email address"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student candidate registry records"
    },
    "/papers/{paperId}": {
      "schema": "Paper",
      "description": "Student examination papers with metadata, rubrics, and storage image references"
    },
    "/markingSchemes/{schemeId}": {
      "schema": "MarkingScheme",
      "description": "Standardized marking schemes and rubrics"
    }
  }
}
