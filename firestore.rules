rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isAuthorizedUser() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()));
    }

    function isDeveloper() {
      return isAuthorizedUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'developer';
    }

    // Users collection:
    // Signed-in users can read their own user record (to verify role and access upon sign-in),
    // and authorized users can list / inspect users.
    // Only developers can add, modify, or delete user entries.
    match /users/{userEmail} {
      allow get: if isSignedIn() && (request.auth.token.email.lower() == userEmail.lower() || isAuthorizedUser());
      allow list: if isAuthorizedUser();
      allow create, update, delete: if isDeveloper();
    }

    // Students collection: accessible only to authorized users
    match /students/{studentId} {
      allow read: if isAuthorizedUser();
      allow create, update, delete: if isAuthorizedUser();
    }

    // Exam Papers collection: accessible only to authorized users
    match /papers/{paperId} {
      allow read: if isAuthorizedUser();
      allow create, update, delete: if isAuthorizedUser();
    }

    // Marking Schemes collection: accessible only to authorized users
    match /markingSchemes/{schemeId} {
      allow read: if isAuthorizedUser();
      allow create, update, delete: if isAuthorizedUser();
    }
  }
}
